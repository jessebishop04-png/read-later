# Production (Vercel): use Postgres — Neon, Vercel Postgres, or Supabase.
# Local: use the same Neon URL, or any Postgres instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Required in production (e.g. openssl rand -base64 32).
AUTH_SECRET=""
# Public app URL (production: https://your-app.vercel.app).
NEXTAUTH_URL="http://localhost:3000"

# OpenAI API key for semantic search embeddings (text-embedding-3-small),
# Writing Feedback, Plagiarism Check, Keepr Chat, and TTS translation.
OPENAI_API_KEY=""
# Optional chat model override (default gpt-4o-mini).
# OPENAI_CHAT_MODEL="gpt-4o-mini"

# GPTZero API key for AI content scanning (https://gptzero.me/developers).
GPTZERO_API_KEY=""

# Optional: Serper Google Search API for live Plagiarism source URLs
# (https://serper.dev). Without it, Plagiarism still runs via OpenAI originality scoring.
# SERPER_API_KEY=""

# Inbound email (Readwise-style forward-to-address). Point MX for this domain to Resend Receiving,
# then set a webhook for email.received → https://your-app/api/inbound/email
# INBOUND_EMAIL_DOMAIN="library.yourdomain.com"
# RESEND_API_KEY=""
# RESEND_WEBHOOK_SECRET=""

# Optional: Jina Reader API key — improves saves when sites block direct fetching (https://jina.ai/reader).
# JINA_API_KEY=""

# Verify DB: with the app running, curl -s http://localhost:3000/api/health
# (expect {"ok":true,"database":"up"}).
